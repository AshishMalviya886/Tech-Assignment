# Server
PORT=3099
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Blockchain network: localhost | sepolia | mainnet
BLOCKCHAIN_NETWORK=localhost
LOCAL_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=

# Deployed contract addresses (required for read/write RPC calls)
REAL_ESTATE_ADDRESS=0x0000000000000000000000000000000000000000
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: server wallet for privileged escrow roles (inspector, etc.)
# Never commit a real key. Prefer prepare-* endpoints + client signing.
SERVER_WALLET_PRIVATE_KEY=

# Frontend (create as .env in project root for CRA)
# REACT_APP_API_URL=http://localhost:3099
